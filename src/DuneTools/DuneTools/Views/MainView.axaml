<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DuneTools.ViewModels"
             xmlns:views="using:DuneTools.Views"
             xmlns:avaloniaHex="clr-namespace:AvaloniaHex;assembly=AvaloniaHex"
             xmlns:editing="clr-namespace:AvaloniaHex.Editing;assembly=AvaloniaHex"
             xmlns:rendering="clr-namespace:AvaloniaHex.Rendering;assembly=AvaloniaHex"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DuneTools.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
    to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,5,*,Auto">
    <!-- File info and upload section -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10">
      <TextBlock Text="File:" VerticalAlignment="Center" FontWeight="Bold" />
      <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
      <TextBlock Text="Size:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,0,0" />
      <TextBlock Text="{Binding FileSize}" VerticalAlignment="Center" />
      <TextBlock Text="bytes" VerticalAlignment="Center" />
      <Button Content="Upload File" Name="UploadButton" Click="OnUploadClick" Margin="20,0,0,0" />
    </StackPanel>

    <TabControl Grid.Row="1" Margin="10,0,10,0" SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">
      <TabItem Header="Globals">
        <ScrollViewer Margin="8">
          <Grid ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                DataContext="{Binding Globals}"
                x:DataType="vm:GlobalsViewModel">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Charisma:" FontWeight="Bold" Margin="0,0,12,6" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Name="CharismaTextBox"
                     Text="{Binding CharismaValue}"
                     IsReadOnly="True"
                     Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Contact Distance:" FontWeight="Bold" Margin="0,0,12,0" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Name="ContactDistanceTextBox"
                     Text="{Binding ContactDistanceValue}"
                     IsReadOnly="True"
                     Margin="0,6,0,0" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Spice:" FontWeight="Bold" Margin="0,12,12,0" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Name="SpiceTextBox"
                     Text="{Binding SpiceValue}"
                     IsReadOnly="True"
                     Margin="0,12,0,0" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Game Stage:" FontWeight="Bold" Margin="0,12,12,0" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Name="GameStageTextBox"
                     Text="{Binding GameStageValue}"
                     IsReadOnly="True"
                     Margin="0,12,0,0" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Stage Description:" FontWeight="Bold" Margin="0,12,12,0" VerticalAlignment="Top" />
            <TextBox Grid.Row="4"
                     Grid.Column="1"
                     Name="GameStageDescriptionTextBox"
                     Text="{Binding GameStageDescription}"
                     IsReadOnly="True" />
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="NPCs">
        <ScrollViewer Margin="8">
          <Grid RowDefinitions="Auto,*" DataContext="{Binding NpcsTab}" x:DataType="vm:SimpleDataTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
              <TextBlock Text="Record" FontWeight="Bold" VerticalAlignment="Center" />
              <ComboBox Width="140" ItemsSource="{Binding RecordOptions}" SelectedIndex="{Binding SelectedIndex}" IsEnabled="{Binding HasRecords}" />
              <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SimpleFieldValueViewModel">
                  <Grid ColumnDefinitions="220,120,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Select" Tag="{Binding}" Click="OnSimpleFieldSelectClick" HorizontalAlignment="Left" />
                    <TextBox Grid.Column="2" Text="{Binding Value}" IsReadOnly="True" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Smugglers">
        <ScrollViewer Margin="8">
          <Grid RowDefinitions="Auto,*" DataContext="{Binding SmugglersTab}" x:DataType="vm:SimpleDataTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
              <TextBlock Text="Record" FontWeight="Bold" VerticalAlignment="Center" />
              <ComboBox Width="140" ItemsSource="{Binding RecordOptions}" SelectedIndex="{Binding SelectedIndex}" IsEnabled="{Binding HasRecords}" />
              <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SimpleFieldValueViewModel">
                  <Grid ColumnDefinitions="220,120,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Select" Tag="{Binding}" Click="OnSimpleFieldSelectClick" HorizontalAlignment="Left" />
                    <TextBox Grid.Column="2" Text="{Binding Value}" IsReadOnly="True" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Locations">
        <ScrollViewer Margin="8">
          <Grid RowDefinitions="Auto,*" DataContext="{Binding LocationsTab}" x:DataType="vm:SimpleDataTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
              <TextBlock Text="Record" FontWeight="Bold" VerticalAlignment="Center" />
              <ComboBox Width="140" ItemsSource="{Binding RecordOptions}" SelectedIndex="{Binding SelectedIndex}" IsEnabled="{Binding HasRecords}" />
              <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SimpleFieldValueViewModel">
                  <Grid ColumnDefinitions="220,120,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Select" Tag="{Binding}" Click="OnSimpleFieldSelectClick" HorizontalAlignment="Left" />
                    <TextBox Grid.Column="2" Text="{Binding Value}" IsReadOnly="True" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Fremen">
        <ScrollViewer Margin="8">
          <Grid RowDefinitions="Auto,*" DataContext="{Binding FremenTab}" x:DataType="vm:SimpleDataTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
              <TextBlock Text="Record" FontWeight="Bold" VerticalAlignment="Center" />
              <ComboBox Width="140" ItemsSource="{Binding RecordOptions}" SelectedIndex="{Binding SelectedIndex}" IsEnabled="{Binding HasRecords}" />
              <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SimpleFieldValueViewModel">
                  <Grid ColumnDefinitions="220,120,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Select" Tag="{Binding}" Click="OnSimpleFieldSelectClick" HorizontalAlignment="Left" />
                    <TextBox Grid.Column="2" Text="{Binding Value}" IsReadOnly="True" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Harkonnen">
        <ScrollViewer Margin="8">
          <Grid RowDefinitions="Auto,*" DataContext="{Binding HarkonnenTab}" x:DataType="vm:SimpleDataTabViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
              <TextBlock Text="Record" FontWeight="Bold" VerticalAlignment="Center" />
              <ComboBox Width="140" ItemsSource="{Binding RecordOptions}" SelectedIndex="{Binding SelectedIndex}" IsEnabled="{Binding HasRecords}" />
              <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SimpleFieldValueViewModel">
                  <Grid ColumnDefinitions="220,120,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Select" Tag="{Binding}" Click="OnSimpleFieldSelectClick" HorizontalAlignment="Left" />
                    <TextBox Grid.Column="2" Text="{Binding Value}" IsReadOnly="True" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Grid splitter -->
    <GridSplitter Grid.Row="2"
                  Background="Gray"
                  ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" />

    <Grid Grid.Row="3" ColumnDefinitions="*,5,*" Margin="10">
      <!-- Hex viewer -->
      <avaloniaHex:HexEditor Grid.Column="0"
                             Name="HexEditorControl"
                             Document="{Binding Document}"
                             FontFamily="Cascadia Code,JetBrains Mono,Consolas,Courier New,monospace"
                             Margin="0,0,10,0">
        <avaloniaHex:HexEditor.Styles>
          <Style Selector="editing|CaretLayer">
            <Setter Property="PrimaryColumnBackground">
              <Setter.Value>
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="1.0" />
              </Setter.Value>
            </Setter>
            <Setter Property="SecondaryColumnBackground">
              <Setter.Value>
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.66" />
              </Setter.Value>
            </Setter>
            <Setter Property="InsertCaretWidth" Value="2" />
          </Style>
          <Style Selector="editing|SelectionLayer">
            <Setter Property="PrimarySelectionBackground">
              <Setter.Value>
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.40" />
              </Setter.Value>
            </Setter>
            <Setter Property="SecondarySelectionBackground">
              <Setter.Value>
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.25" />
              </Setter.Value>
            </Setter>
          </Style>
        </avaloniaHex:HexEditor.Styles>
        <avaloniaHex:HexEditor.Columns>
          <rendering:OffsetColumn />
          <rendering:HexColumn />
          <rendering:AsciiColumn />
        </avaloniaHex:HexEditor.Columns>
      </avaloniaHex:HexEditor>

      <GridSplitter Grid.Column="1"
                    Background="Gray"
                    ResizeDirection="Columns"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

      <views:HexSelectionInspectorView Grid.Column="2"
                                       MinWidth="280"
                                       DataContext="{Binding Inspector}" />
    </Grid>

    <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="1,1,1,0" Padding="8,6" Margin="10,0,10,6">
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
        <TextBlock Grid.Column="0" Text="Status" FontWeight="Bold" />
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Margin="8,0,16,0" />

        <TextBlock Grid.Column="2" Text="Offset" FontWeight="Bold" />
        <TextBlock Grid.Column="3" Text="{Binding StatusSelectionOffset}" Margin="8,0,16,0" />

        <TextBlock Grid.Column="4" Text="Length" FontWeight="Bold" />
        <TextBlock Grid.Column="5" Text="{Binding StatusSelectionLength}" Margin="8,0,16,0" />

        <TextBlock Grid.Column="6" Text="Primary" FontWeight="Bold" />
        <TextBlock Grid.Column="7" Text="{Binding StatusPrimaryField}" Margin="8,0,16,0" />

        <TextBlock Grid.Column="8" Text="State" FontWeight="Bold" />
        <TextBlock Grid.Column="9" Text="{Binding StatusKnownState}" Margin="8,0,16,0" />

        <TextBlock Grid.Column="10" Text="Coverage" FontWeight="Bold" />
        <TextBlock Grid.Column="11" Text="{Binding StatusCoveragePercent}" Margin="8,0,16,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>

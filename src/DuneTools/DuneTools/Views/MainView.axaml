<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DuneTools.ViewModels"
             xmlns:views="using:DuneTools.Views"
             xmlns:avaloniaHex="clr-namespace:AvaloniaHex;assembly=AvaloniaHex"
             xmlns:rendering="clr-namespace:AvaloniaHex.Rendering;assembly=AvaloniaHex"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DuneTools.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <!-- This only sets the DataContext for the previewer in an IDE,
    to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,5,*">
    <!-- File info and upload section -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10">
      <TextBlock Text="File:" VerticalAlignment="Center" FontWeight="Bold" />
      <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
      <TextBlock Text="Size:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,0,0" />
      <TextBlock Text="{Binding FileSize}" VerticalAlignment="Center" />
      <TextBlock Text="bytes" VerticalAlignment="Center" />
      <Button Content="Upload File" Name="UploadButton" Click="OnUploadClick" Margin="20,0,0,0" />
    </StackPanel>

    <TabControl Grid.Row="1" Margin="10,0,10,0">
      <TabItem Header="Generals">
        <Grid ColumnDefinitions="Auto,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              Margin="8"
              DataContext="{Binding Generals}"
              x:DataType="vm:GeneralsViewModel">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Charisma:" FontWeight="Bold" Margin="0,0,12,6" />
          <TextBox Grid.Row="0"
                   Grid.Column="1"
                   Name="CharismaTextBox"
                   Text="{Binding CharismaValue}"
                   IsReadOnly="True"
                   Margin="0,0,0,6" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Contact Distance:" FontWeight="Bold" Margin="0,0,12,0" />
          <TextBox Grid.Row="1"
                   Grid.Column="1"
                   Name="ContactDistanceTextBox"
                   Text="{Binding ContactDistanceValue}"
                   IsReadOnly="True"
                   Margin="0,6,0,0" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Spice:" FontWeight="Bold" Margin="0,12,12,0" />
          <TextBox Grid.Row="2"
                   Grid.Column="1"
                   Name="SpiceTextBox"
                   Text="{Binding SpiceValue}"
                   IsReadOnly="True"
                   Margin="0,12,0,0" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Game Stage:" FontWeight="Bold" Margin="0,12,12,0" />
          <TextBox Grid.Row="3"
                   Grid.Column="1"
                   Name="GameStageTextBox"
                   Text="{Binding GameStageValue}"
                   IsReadOnly="True"
                   Margin="0,12,0,0" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Stage Description:" FontWeight="Bold" Margin="0,12,12,0" VerticalAlignment="Top" />
          <TextBox Grid.Row="4"
                   Grid.Column="1"
                   Name="GameStageDescriptionTextBox"
                   Text="{Binding GameStageDescription}"
                   IsReadOnly="True" />
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Grid splitter -->
    <GridSplitter Grid.Row="2"
                  Background="Gray"
                  ResizeDirection="Rows"
                  HorizontalAlignment="Stretch" />

    <Grid Grid.Row="3" ColumnDefinitions="*,5,320" Margin="10">
      <!-- Hex viewer -->
      <avaloniaHex:HexEditor Grid.Column="0"
                             Name="HexEditorControl"
                             Document="{Binding Document}"
                             FontFamily="Cascadia Code,JetBrains Mono,Consolas,Courier New,monospace"
                             Margin="0,0,10,0">
        <avaloniaHex:HexEditor.Columns>
          <rendering:OffsetColumn />
          <rendering:HexColumn />
          <rendering:AsciiColumn />
        </avaloniaHex:HexEditor.Columns>
      </avaloniaHex:HexEditor>

      <GridSplitter Grid.Column="1"
                    Background="Gray"
                    ResizeDirection="Columns"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

      <views:HexSelectionInspectorView Grid.Column="2"
                                       MinWidth="240"
                                       DataContext="{Binding Inspector}" />
    </Grid>
  </Grid>
</UserControl>

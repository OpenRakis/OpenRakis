<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pgc="clr-namespace:Avalonia.PropertyGrid.Controls;assembly=Avalonia.PropertyGrid"
             xmlns:vm="using:DuneTools.ViewModels"
             mc:Ignorable="d"
             x:Class="DuneTools.Views.HexSelectionInspectorView"
             x:DataType="vm:HexSelectionInspectorViewModel">
    <Border BorderBrush="Gray" BorderThickness="1" Padding="10">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Text="Selection Inspector" FontWeight="Bold" FontSize="16" />
                <TextBlock Text="{Binding Info.StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
                <pgc:PropertyGrid DataContext="{Binding Info}" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>